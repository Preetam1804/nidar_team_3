<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="survivor_beacon">
    <static>true</static>
    <link name="link">
      <!-- Slender vertical pin -->
      <visual name="pin">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.9</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.95 0.65 1.0</ambient>
          <diffuse>0.0 0.95 0.65 1.0</diffuse>
          <emissive>0.0 0.4 0.25 1.0</emissive>
        </material>
      </visual>

      <!-- Glowing sphere on top -->
      <visual name="beacon_head">
        <pose>0 0 0.95 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.15</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.1 1.0 0.5 1.0</ambient>
          <diffuse>0.1 1.0 0.5 1.0</diffuse>
          <emissive>0.2 1.0 0.6 1.0</emissive>
        </material>
      </visual>

      <!-- Floor marker ring -->
      <visual name="ground_ring">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.45</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.8 0.5 0.7</ambient>
          <diffuse>0.0 0.8 0.5 0.7</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
